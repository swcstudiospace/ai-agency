[Unit]
Description=Hermes Reverse Bridge (Agno → Hermes tools + KIP)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/src/repos/ai-agency
Environment=PYTHONPATH=/root/src/repos/ai-agency
EnvironmentFile=-/root/src/repos/ai-agency/.env
EnvironmentFile=-/root/.config/hermes-linear/connector.env
ExecStart=/root/src/repos/ai-agency/.venv/bin/python -m hermes_bridge.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

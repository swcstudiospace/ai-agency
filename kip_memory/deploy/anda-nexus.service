[Unit]
Description=Anda Cognitive Nexus (KIP HTTP) for AI Agency
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/src/repos/ai-agency/kip_memory/data
Environment=RUST_LOG=info
# Loopback only — no API_KEY required
ExecStart=/root/.cargo/bin/anda_cognitive_nexus_server --addr 127.0.0.1:8091 local --db /root/src/repos/ai-agency/kip_memory/data/anda_db
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

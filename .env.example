# Fal.ai (UGC avatar video + images)
FAL_KEY=
# FAL_AVATAR_ENDPOINT=argil/avatars/text-to-video
# FAL_AVATAR_ID=Noemie car (UGC)
# FAL_VOICE_ID=Rachel
# FAL_IMAGE_ENDPOINT=fal-ai/flux/dev

# Meta Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# META_PIXEL_ID=
# META_GRAPH_VERSION=v21.0
# META_AUTO_CREATE_PAUSED=0

# TikTok Marketing API
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
# TIKTOK_API_BASE=https://business-api.tiktok.com/open_api/v1.3

# Logistics (optional)
# SEVENTEENTRACK_TOKEN=

# Autonomy / HITL
# AGENCY_AUTONOMY=L2
# AGENCY_SPEND_VAULT=tmp/spend_vault.json

# Optional infra
TEMPORAL_ADDRESS=localhost:7233

# AgentOS
# AGENCY_PORT=7777
# AGENCY_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# AGENCY_MCP_RESULT_MODE=trimmed
# AGENCY_MCP_REQUIRE_AUTH=0

# Drop universal MCP+ACP gateway (drop.autonogrammer.ai → :7788)
DROP_MCP_TOKEN=
DROP_HOST=127.0.0.1
DROP_PORT=7788
DROP_MCP_REQUIRE_AUTH=1
DROP_MCP_ALLOW_LOCALHOST=1

# Hermes reverse bridge (Agno → Hermes tools)
HERMES_BRIDGE_HOST=127.0.0.1
HERMES_BRIDGE_PORT=7790
HERMES_BRIDGE_URL=http://127.0.0.1:7790/mcp
HERMES_BRIDGE_TOKEN=
HERMES_BRIDGE_ALLOW_LOCALHOST=1
# KIP shared memory / ICP
KIP_ICP_MODE=local
# KIP_ICP_MODE=canister
# IC_OSS_ENDPOINT=
# KIP_ICP_CANISTER_ID=

# Anda Cognitive Nexus (official Rust KIP server)
ANDA_NEXUS_URL=http://127.0.0.1:8091
# ANDA_NEXUS_API_KEY=
# KIP_ICP_MODE=local|canister|s3|ic_oss
# IC_OSS_ENDPOINT=
# KIP_ICP_CANISTER_ID=
# KIP_S3_BUCKET=

# Ops analytics (optional Postgres; default SQLite kip_memory/data/analytics.db)
# AGENCY_ANALYTICS_DSN=postgresql://user:pass@localhost:5432/agency

# Linear — spectrumwebco / SWC / AI Dropshipping Agency
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_TEAM_KEY=SWC
LINEAR_PROJECT_ID=
LINEAR_PROJECT_NAME="AI Dropshipping Agency"
LINEAR_ORG=spectrumwebco
LINEAR_GITHUB_REPO=swcstudiospace/ai-agency
LINEAR_GITHUB_LINK=1

# PromptWise UGC (browser via Hermes bridge; optional API)
PROMPTWISE_APP_URL=https://app.promptwise.com
PROMPTWISE_BROWSER_ENABLED=1
PROMPTWISE_API_KEY=
PROMPTWISE_API_BASE=

# Shopify Dev Dashboard app (client credentials → 24h Admin token)
SHOPIFY_SHOP_NAME=           # required: your-store (for your-store.myshopify.com)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=      # optional static token; else auto via client credentials
# SHOPIFY_API_VERSION=2024-10

# Brand domain (headless + DNS plan)
AGENCY_PRIMARY_DOMAIN=ego.engineer
SHOPIFY_PRIMARY_DOMAIN=ego.engineer
AGENCY_BRAND_NAME=ego.engineer
OUTREACH_BROWSER_ENABLED=1
OUTREACH_FROM_NAME=Sourcing
# OUTREACH_DEFAULT_TO=


# AGENCY_MCP_RESULT_MODE=trimmed
# AGENCY_MCP_REQUIRE_AUTH=0

# Drop universal MCP+ACP gateway (drop.autonogrammer.ai → :7788)
DROP_MCP_TOKEN=
DROP_HOST=127.0.0.1
DROP_PORT=7788
DROP_MCP_REQUIRE_AUTH=1
DROP_MCP_ALLOW_LOCALHOST=1

# Hermes reverse bridge (Agno → Hermes tools)
HERMES_BRIDGE_HOST=127.0.0.1
HERMES_BRIDGE_PORT=7790
HERMES_BRIDGE_URL=http://127.0.0.1:7790/mcp
HERMES_BRIDGE_TOKEN=
HERMES_BRIDGE_ALLOW_LOCALHOST=1
# KIP shared memory / ICP
KIP_ICP_MODE=local
# KIP_ICP_MODE=canister
# IC_OSS_ENDPOINT=
# KIP_ICP_CANISTER_ID=

# Anda Cognitive Nexus (official Rust KIP server)

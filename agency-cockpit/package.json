{
  "name": "agency-cockpit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hermes × Agno Agency Cockpit — web PWA, Tauri desktop, Tauri mobile",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 0.0.0.0 --port 1420",
    "build": "npm run build:web",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
    "build:pwa": "npm run build:web",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "preview:web": "npm run preview",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:linux": "tauri build --bundles deb,appimage",
    "desktop:build:appimage": "tauri build --bundles appimage",
    "desktop:build:deb": "tauri build --bundles deb",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "android:build:aab": "tauri android build --aab",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "package:all": "npm run icons && npm run build:web && npm run desktop:build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.2.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.3",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-pwa": "^0.21.2",
    "workbox-window": "^7.3.0"
  }
}
